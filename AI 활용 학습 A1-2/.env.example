# 실제 키 값은 이 파일에 작성하거나 커밋하지 마세요.
# 이 파일을 .env로 복사한 뒤 각자의 키를 입력하세요.
GEMINI_API_KEY=여기에_Gemini_API_키_입력
KAKAO_REST_API_KEY=여기에_Kakao_REST_API_키_입력

# 선택 사항: Google AI Studio 계정에서 사용 가능한 모델로 바꿀 때만 설정합니다.
# 무료 등급의 모델·요청 제한은 계정과 시점에 따라 달라질 수 있습니다.
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter 설정 (3중 폴백의 두 번째 제공자)
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openrouter/free

# Copa (OpenAI 호환) 설정 - 3중 폴백의 세 번째 제공자
COPA_API_KEY=YOUR_COPA_API_KEY
COPA_MODEL=gpt-5.4-mini
